# Market data server configuration
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
# `.env` is gitignored and must never be committed.

# Port the local market data server listens on.
MARKET_DATA_PORT=8787

# Browser origin allowed to call the market data server (CORS).
MARKET_DATA_ALLOWED_ORIGIN=http://localhost:5173

# Eastmoney public gateway tokens.
# These are the shared "ut"/"token" values Eastmoney's open quote endpoints
# expect. They are not per-user private credentials, but they are still kept
# out of source control so they can be rotated/overridden without code changes.
EASTMONEY_TOKEN=fa5fd1943c7b386f172d6893dbfba10b
EASTMONEY_LIMIT_UP_TOKEN=7eea3edcaed734bea9cbfc24409ed989
EASTMONEY_SEARCH_TOKEN=D43BF722C8E33BDC906FB84D85E326E8
