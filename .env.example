# Optional overrides for Eastmoney public web tokens.
# Defaults already match the tokens used by Eastmoney's public quote pages.
# Jessica only needs to set these in Vercel if the public tokens rotate.
EASTMONEY_QUOTE_TOKEN=
EASTMONEY_LIMIT_UP_TOKEN=
EASTMONEY_SEARCH_TOKEN=

# Comma-separated quote hosts. push2.eastmoney.com is preferred in-region;
# push2delay is the public fallback when push2 returns 502 from overseas/Vercel.
EASTMONEY_QUOTE_HOSTS=https://push2.eastmoney.com,https://push2delay.eastmoney.com

# Local market data server (npm run dev / npm run data:server)
MARKET_DATA_PORT=8787
MARKET_DATA_CACHE_TTL_MS=30000
MARKET_DATA_TIMEOUT_MS=8000
